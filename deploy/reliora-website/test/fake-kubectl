#!/bin/sh
# A stand-in for kubectl in the local test (test/run-local.sh). It keeps cluster
# state as files in /fake and answers only the calls deployer.sh makes. It is
# not Kubernetes: the real cluster calls are checked at cutover.
F=/fake
args="$*"
case "$args" in
  *"get lease site-deployer -o json"*) cat $F/lease.json ;;
  *"replace -f -"*) # optimistic: accept only if resourceVersion matches
    new="$(cat)"; rv="$(echo "$new" | jq -r .metadata.resourceVersion)"
    [ "$rv" = "$(jq -r .metadata.resourceVersion $F/lease.json)" ] || exit 1
    echo "$new" | jq ".metadata.resourceVersion=\"$((rv + 1))\"" > $F/lease.tmp && mv $F/lease.tmp $F/lease.json ;;
  *"patch lease site-deployer"*) jq '.spec.holderIdentity=""' $F/lease.json > $F/lease.tmp && mv $F/lease.tmp $F/lease.json ;;
  *"get pod "*) h="$(echo "$args" | sed 's/.*get pod \([^ ]*\).*/\1/')"; [ -f "$F/pod-$h" ] && echo Running || exit 1 ;;
  *"get configmap site-deploy-state -o json"*) cat $F/cm.json ;;
  *"patch configmap site-deploy-state"*) p="$(echo "$args" | sed 's/.* -p //')"; jq --argjson p "$p" '.data += $p.data' $F/cm.json > $F/cm.tmp && mv $F/cm.tmp $F/cm.json ;;
  *"get deploy reliora-website -o json"*) [ -f $F/api-down ] && exit 1
    jq -n --arg m "$(cat $F/serving 2>/dev/null)" '{metadata:{annotations:(if $m=="" then {} else {"reliora.ai/serving":$m} end)}}' ;;
  *"reliora\.ai/config-hash"*) [ -f $F/api-down ] && exit 1; cat $F/hash 2>/dev/null ;;
  *"patch deploy reliora-website"*) p="$(echo "$args" | sed 's/.* -p //')"; echo "$p" | jq -r '.spec.template.metadata.annotations["reliora.ai/config-hash"]' > $F/hash; echo restart >> $F/events ;;
  *"rollout status"*) sleep 4 ;;
  *"get endpointslices"*) [ -f $F/api-down ] && exit 1
    if [ -f $F/bad-endpoints-once ]; then rm -f $F/bad-endpoints-once
      echo '{"items":[{"endpoints":[{"addresses":["172.31.255.254"],"conditions":{"serving":true,"terminating":false}}]}]}'
    else jq -n --arg ip "$(cat $F/live-ip)" '{items:[{endpoints:[{addresses:[$ip],conditions:{serving:true,terminating:false}},{addresses:["10.9.9.9"],conditions:{serving:true,terminating:true}}]}]}'; fi ;;
  *) echo "fake-kubectl: unhandled: $args" >&2; exit 1 ;;
esac
